flowchart TB
    subgraph Init["🟢 启动初始化"]
        Step1["ThemeManager.init()"]
    end

    subgraph Storage["💾 PersistentStorage"]
        Disk["persistProp('themeName', 'frosted')  — 磁盘持久化"]
    end

    subgraph Global["🌐 AppStorage"]
        AS["themeName: 'frosted' 或 'contrast'  — 全局唯一真相源"]
    end

